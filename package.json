{
  "name": "construction-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts --host 127.0.0.1",
    "build": "tsc -b frontend && vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts --host 127.0.0.1",
    "check": "tsc -b frontend && eslint . && node frontend/scripts/check-boundaries.mjs && node scripts/check-secrets.mjs",
    "test": "vitest run --config frontend/vite.config.ts && node --test frontend/scripts/*.test.mjs",
    "test:watch": "vitest --config frontend/vite.config.ts",
    "test:e2e": "playwright test",
    "test:api": "node --env-file=.env.local --test backend/tests/api/*.test.mjs",
    "db:start": "node backend/scripts/cli.mjs start",
    "db:reset": "node backend/scripts/cli.mjs db reset --local",
    "db:test": "node backend/scripts/cli.mjs test db",
    "db:types": "node backend/scripts/cli.mjs gen types typescript --local --schema public > frontend/src/shared/api/database.types.ts && prettier --write frontend/src/shared/api/database.types.ts",
    "demo:seed": "node --env-file=.env.local backend/scripts/seed-demo.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:local": "node backend/scripts/setup-local.mjs",
    "test:api:local": "node --env-file=.env.local backend/scripts/test-local-api.mjs",
    "test:ui:local": "node --env-file=.env.local scripts/test-live-ui.mjs",
    "test:postgres:local": "node --test backend/tests/postgres/*.test.mjs",
    "db:profile": "node backend/scripts/profile-queries.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@supabase/supabase-js": "^2.80.0",
    "@tanstack/react-query": "^5.90.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.548.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "react-router-dom": "^7.9.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "supabase": "^2.58.0",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.2.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
